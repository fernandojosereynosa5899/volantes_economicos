---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getActiveConfig } from '../scripts/content-loader';
import Icon from '../components/Icon.astro';

const siteConfig = getActiveConfig();
const whatsappUrl = `https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me gustaría cotizar precios de volantes económicos.')}`;
---

<Layout 
  title="PRECIOS - Volantes Económicos" 
  description="Tenemos los mejores precios con entregas a todo México ! Cotiza tus volantes publicitarios directamente por WhatsApp."
  currentPath="/precios"
>
  <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
    <div class="page-layout-grid">
      <!-- Main Content Area -->
      <article class="page-content-area original-content-typography">
        <h1 class="main-page-title" style="margin-bottom: 0.5rem;">PRECIOS</h1>
        <p class="lead-text" style="color: var(--color-primary); font-weight: 700; margin-bottom: 2rem;">
          Tenemos los mejores precios con entregas a todo México !
        </p>

        <p>
          En Volantes Económicos nos preocupamos porque su negocio tenga la mejor publicidad a los precios más bajos y accesibles. Todas nuestras impresiones se realizan en máquinas offset con tintas de alta calidad sobre papel couché brillante.
        </p>

        <p style="font-size: 1.05rem; margin-bottom: 2rem;">
          Para brindarte la tarifa más competitiva y ajustada a tus necesidades, cotizamos directamente por WhatsApp en minutos. Elige el paquete que mejor se adapte a tu campaña:
        </p>

        <!-- Paquetes sin precios fijos, enfocados a cotización en WhatsApp -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin: 2rem 0;">
          <div class="step-card" style="text-align: center;">
            <span style="font-size: 0.85rem; font-weight: 800; color: var(--color-primary); text-transform: uppercase;">Paquete Básico</span>
            <h3 style="font-size: 1.5rem; font-weight: 800; color: #111827; margin: 0.5rem 0;">1,000 Volantes</h3>
            <p style="font-size: 0.95rem; color: #64748b; margin-bottom: 1.5rem;">1/4 de Carta • Papel Couché • Full Color</p>
            <a 
              href={`https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me interesa cotizar el paquete de 1,000 volantes.')}`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-whatsapp" 
              style="width: 100%;"
            >
              <Icon name="whatsapp" size={18} />
              <span>Cotizar 1,000 pzas</span>
            </a>
          </div>

          <div class="step-card" style="text-align: center; border-color: var(--color-primary);">
            <span style="font-size: 0.85rem; font-weight: 800; color: var(--color-primary); text-transform: uppercase;">Más Popular ⭐</span>
            <h3 style="font-size: 1.5rem; font-weight: 800; color: #111827; margin: 0.5rem 0;">5,000 Volantes</h3>
            <p style="font-size: 0.95rem; color: #64748b; margin-bottom: 1.5rem;">1/4 de Carta • Couché Brillante • Máximo Impacto</p>
            <a 
              href={`https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me interesa cotizar el paquete de 5,000 volantes.')}`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-whatsapp" 
              style="width: 100%;"
            >
              <Icon name="whatsapp" size={18} />
              <span>Cotizar 5,000 pzas</span>
            </a>
          </div>

          <div class="step-card" style="text-align: center;">
            <span style="font-size: 0.85rem; font-weight: 800; color: var(--color-primary); text-transform: uppercase;">Gran Alcance</span>
            <h3 style="font-size: 1.5rem; font-weight: 800; color: #111827; margin: 0.5rem 0;">10,000 Volantes</h3>
            <p style="font-size: 0.95rem; color: #64748b; margin-bottom: 1.5rem;">1/4 de Carta • Mejor precio por pieza</p>
            <a 
              href={`https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me interesa cotizar el paquete de 10,000 volantes.')}`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-whatsapp" 
              style="width: 100%;"
            >
              <Icon name="whatsapp" size={18} />
              <span>Cotizar 10,000 pzas</span>
            </a>
          </div>
        </div>

        <!-- Closing CTA -->
        <div class="closing-cta-card">
          <p class="closing-text">
            ¿Requieres otra medida, cantidad o papel especial?<br/>
            <strong>CONTACTANOS PARA COTIZAR POR WHATSAPP</strong>
          </p>
          <div class="closing-cta-action">
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="closing-whatsapp-btn"
              title="Cotizar por WhatsApp"
            >
              <Icon name="whatsapp" size={28} />
              <div class="closing-btn-text">
                <span class="closing-btn-subtitle">Cotizar por WhatsApp</span>
                <strong class="closing-btn-number" data-bind="general.phoneNumber">{siteConfig.general.phoneNumber}</strong>
              </div>
            </a>
          </div>
        </div>
      </article>

      <!-- Sidebar Column -->
      <Sidebar />
    </div>
  </div>
</Layout>
