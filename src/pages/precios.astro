---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getActiveConfig } from '../scripts/content-loader';
import Icon from '../components/Icon.astro';

const siteConfig = getActiveConfig();
const whatsappUrl = `https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me gustaría cotizar precios de volantes económicos.')}`;
---

<Layout 
  title="PRECIOS - Volantes Económicos" 
  description="Tenemos los mejores precios con entregas a todo México ! Cotiza tus volantes publicitarios directamente por WhatsApp."
  currentPath="/precios"
>
  <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
    <div class="page-layout-grid">
      <!-- Main Content Area -->
      <article class="page-content-area original-content-typography">
        <h1 class="main-page-title" style="margin-bottom: 0.5rem;">PRECIOS</h1>
        <p class="lead-text" style="color: var(--color-primary); font-weight: 700; margin-bottom: 2rem;">
          Tenemos los mejores precios con entregas a todo México !
        </p>

        <p>
          En Volantes Económicos nos preocupamos porque su negocio tenga la mejor publicidad a los precios más bajos y accesibles. Todas nuestras impresiones se realizan en máquinas offset con tintas de alta calidad sobre papel couché brillante.
        </p>

        <p style="font-size: 1.05rem; margin-bottom: 2rem;">
          Para brindarte la tarifa más competitiva y ajustada a las medidas, papel y tiraje de tu campaña, cotizamos directamente por WhatsApp en minutos:
        </p>

        <!-- Closing CTA -->
        <div class="closing-cta-card">
          <p class="closing-text">
            ¿Requieres otra medida, cantidad o papel especial?<br/>
            <strong>CONTACTANOS PARA COTIZAR POR WHATSAPP</strong>
          </p>
          <div class="closing-cta-action">
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="closing-whatsapp-btn"
              title="Cotizar por WhatsApp"
            >
              <Icon name="whatsapp" size={28} />
              <div class="closing-btn-text">
                <span class="closing-btn-subtitle">Cotizar por WhatsApp</span>
                <strong class="closing-btn-number" data-bind="general.phoneNumber">{siteConfig.general.phoneNumber}</strong>
              </div>
            </a>
          </div>
        </div>
      </article>

      <!-- Sidebar Column -->
      <Sidebar />
    </div>
  </div>
</Layout>
