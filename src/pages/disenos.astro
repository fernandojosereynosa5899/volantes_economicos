---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import NuestrosTrabajos from '../components/NuestrosTrabajos.astro';
import { getGithubImageUrl } from '../config/site';
import '../styles/components/gallery.css';

const designs = [
  {
    id: 1,
    title: 'Diseño 1',
    image: getGithubImageUrl('diseño_1.jpg'),
    description: 'Publicidad con colores vivos y llamado a la acción comercial.'
  },
  {
    id: 2,
    title: 'Diseño 2',
    image: getGithubImageUrl('diseño_2.jpg'),
    description: 'Muestra gráfica para negocio con impresión de alta calidad offset.'
  },
  {
    id: 3,
    title: 'Diseño 3',
    image: getGithubImageUrl('diseño_3.jpg'),
    description: 'Muestra publicitaria para restaurantes, pizzerías y negocios locales.'
  },
  {
    id: 4,
    title: 'Diseño 4',
    image: getGithubImageUrl('diseño_4.jpg'),
    description: 'Composición publicitaria enfocada a promociones comerciales y ventas.'
  },
  {
    id: 5,
    title: 'Diseño 5',
    image: getGithubImageUrl('diseño_5.jpg'),
    description: 'Gran impacto visual y alta calidad de impresión offset profesional.'
  },
  {
    id: 6,
    title: 'Diseño 6',
    image: getGithubImageUrl('diseño_6.jpg'),
    description: 'Formato publicitario optimizado para máxima atracción de nuevos clientes.'
  },
  {
    id: 7,
    title: 'Diseño 7',
    image: getGithubImageUrl('diseño_7.jpg'),
    description: 'Estructura publicitaria con tipografía clara y acabado profesional.'
  },
  {
    id: 8,
    title: 'Diseño 8',
    image: getGithubImageUrl('diseño_8.jpg'),
    description: 'Composición visual clara, atractiva y colores balanceados.'
  }
];
---

<Layout 
  title="DISEÑOS - Volantes Económicos" 
  description="Así trabajamos en Volantes Económicos. Muestras de diseños de volantes publicitarios para su negocio."
  currentPath="/disenos"
>
  <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
    <!-- Main Content Column Full-Width (Captura 172823 y 172851) -->
    <div class="page-content-area" style="max-width: 100%;">
      <h1 class="main-page-title" style="margin-bottom: 0.5rem;">DISEÑOS</h1>
      <p class="lead-text" style="color: var(--color-primary); font-weight: 700; margin-bottom: 2rem;">
        Así trabajamos !
      </p>

      <!-- Gallery Grid - 3 Columnas (Captura 172851) -->
      <div class="gallery-grid-3cols">
        {designs.map((item, idx) => (
          <div 
            class="gallery-card gallery-card-pure-img reveal-item"
            data-img={item.image}
            data-title={item.title}
            data-desc={item.description}
            style={`animation-delay: ${idx * 0.08}s;`}
          >
            <div class="gallery-img-wrapper">
              <img 
                src={item.image} 
                alt={item.title} 
                class="gallery-img"
                loading="lazy"
                width="500"
                height="500"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Trabajos y Portafolio con Filtros interactivos de Pagina -->
  <NuestrosTrabajos />

  <!-- Lightbox Modal con animaciones fluidas -->
  <div class="lightbox-modal" id="gallery-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="lightbox-content">
      <button class="lightbox-close-btn" id="lightbox-close" aria-label="Cerrar vista previa">
        <Icon name="close" size={20} />
      </button>

      <div class="lightbox-media" style="position: relative; min-height: 340px;">
        <div class="lightbox-loader hidden" id="lightbox-loader">
          <div class="lightbox-spinner-ring"></div>
          <span class="lightbox-loader-text">Descargando imagen...</span>
        </div>
        <img src="" id="lightbox-target-img" alt="Vista previa de diseño" class="img-lazy-animate" />
      </div>

      <div class="lightbox-details">
        <div>
          <h3 class="lightbox-title" id="lightbox-target-title">Título del Diseño</h3>
          <p class="lightbox-desc" id="lightbox-target-desc">Muestra gráfica de impresión offset.</p>
        </div>

        <a 
          href="#" 
          id="lightbox-whatsapp-cta" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-whatsapp"
          style="width: 100%;"
        >
          <Icon name="whatsapp" size={20} />
          <span>Cotizar este Diseño por WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .gallery-grid-3cols {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 2rem !important;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .gallery-card-pure-img {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .gallery-card-pure-img:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 16px 30px -8px rgba(0, 0, 0, 0.15);
    border-color: rgba(193, 18, 31, 0.35);
  }

  .gallery-img-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #ffffff;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-card-pure-img:hover .gallery-img {
    transform: scale(1.03);
  }

  @media (max-width: 992px) {
    .gallery-grid-3cols {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 1.5rem !important;
    }
  }

  @media (max-width: 600px) {
    .gallery-grid-3cols {
      grid-template-columns: 1fr !important;
      gap: 1.25rem !important;
    }
    .gallery-card-pure-img {
      border-radius: 8px;
    }
    .gallery-img-wrapper {
      border-radius: 7px;
    }
  }
</style>

<script>
  import { initGallery } from '../scripts/gallery';
  document.addEventListener('DOMContentLoaded', () => {
    initGallery();
  });
  document.addEventListener('astro:page-load', () => {
    initGallery();
  });
</script>
