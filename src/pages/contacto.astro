---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getActiveConfig } from '../scripts/content-loader';
import Icon from '../components/Icon.astro';

const siteConfig = getActiveConfig();
const whatsappUrl = `https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me gustaría cotizar volantes para mi negocio.')}`;
---

<Layout 
  title="CONTACTO - Volantes Económicos" 
  description="Nos da mucho gusto atenderte y ofrecerte los mejores precios ! Contáctanos por WhatsApp o teléfono."
  currentPath="/contacto"
>
  <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
    <div class="page-layout-grid">
      <!-- Main Content Area -->
      <article class="page-content-area original-content-typography">
        <h1 class="main-page-title" style="margin-bottom: 0.5rem;">CONTACTO</h1>
        <p class="lead-text" style="color: var(--color-primary); font-weight: 700; margin-bottom: 2rem;" data-bind="contacto.subtitle">
          Nos da mucho gusto atenderte y ofrecerte los mejores precios !
        </p>

        <!-- Formulario de Contacto Limpio y Moderno -->
        <div class="step-card" style="margin-bottom: 2.5rem; padding: 2rem;">
          <h3 style="font-size: 1.3rem; font-weight: 700; color: #111827; margin-bottom: 0.5rem;">
            Escríbenos tu mensaje
          </h3>
          <p style="color: #475569; font-size: 0.95rem; margin-bottom: 1.5rem;">
            Completa el siguiente formulario para cotizar tus volantes o resolver cualquier duda. También puedes contactarnos directamente por WhatsApp.
          </p>

          <form class="clean-contact-form" id="main-contact-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
              <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                <label for="contact-name" style="font-size: 0.88rem; font-weight: 700; color: #374151;">Nombre Completo *</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  required 
                  placeholder="Tu nombre o el de tu negocio" 
                  style="padding: 0.75rem 0.95rem; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); font-size: 0.95rem; background: #ffffff; color: #111827; outline: none;"
                />
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                <label for="contact-phone" style="font-size: 0.88rem; font-weight: 700; color: #374151;">Teléfono / WhatsApp *</label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  required 
                  placeholder="Ej: 55 1234 5678" 
                  style="padding: 0.75rem 0.95rem; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); font-size: 0.95rem; background: #ffffff; color: #111827; outline: none;"
                />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
              <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                <label for="contact-email" style="font-size: 0.88rem; font-weight: 700; color: #374151;">Correo Electrónico</label>
                <input 
                  type="email" 
                  id="contact-email" 
                  placeholder="tucorreo@ejemplo.com" 
                  style="padding: 0.75rem 0.95rem; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); font-size: 0.95rem; background: #ffffff; color: #111827; outline: none;"
                />
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                <label for="contact-qty" style="font-size: 0.88rem; font-weight: 700; color: #374151;">Cantidad Estimada</label>
                <select 
                  id="contact-qty" 
                  style="padding: 0.75rem 0.95rem; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); font-size: 0.95rem; background: #ffffff; color: #111827; outline: none;"
                >
                  <option value="1000">1,000 Volantes</option>
                  <option value="2500">2,500 Volantes</option>
                  <option value="5000">5,000 Volantes</option>
                  <option value="10000">10,000 Volantes</option>
                  <option value="otro">Otra cantidad personalizada</option>
                </select>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.35rem;">
              <label for="contact-message" style="font-size: 0.88rem; font-weight: 700; color: #374151;">Mensaje o Detalles del Pedido</label>
              <textarea 
                id="contact-message" 
                rows="4" 
                placeholder="Escribe aquí tu mensaje o detalles de lo que necesitas..." 
                style="padding: 0.75rem 0.95rem; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); font-size: 0.95rem; background: #ffffff; color: #111827; outline: none; resize: vertical;"
              ></textarea>
            </div>

            <button type="submit" class="btn btn-whatsapp btn-lg" style="margin-top: 0.5rem;">
              <Icon name="whatsapp" size={22} />
              <span>Enviar por WhatsApp</span>
            </button>
          </form>
        </div>

        <!-- Tarjetas de Información de Contacto Mejoradas sin desbordamiento -->
        <div class="contact-cards-grid">
          <!-- WhatsApp Principal -->
          <div class="step-card contact-channel-card">
            <div class="contact-channel-icon-wrap" style="background: #f0fdf4;">
              <Icon name="whatsapp" size={26} />
            </div>
            <div class="contact-channel-body">
              <h4 class="contact-channel-title">WhatsApp</h4>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-channel-link" style="color: var(--color-whatsapp-dark);">
                {siteConfig.general.phoneNumber}
              </a>
            </div>
          </div>

          <!-- Correo Electrónico Mejorado y Ajustado -->
          <div class="step-card contact-channel-card">
            <div class="contact-channel-icon-wrap" style="background: #f0f9ff;">
              <Icon name="mail" size={24} />
            </div>
            <div class="contact-channel-body">
              <h4 class="contact-channel-title">Correo Electrónico</h4>
              <a href={`mailto:${siteConfig.general.email}`} class="contact-channel-link email-text-link" style="color: #0284c7;">
                {siteConfig.general.email}
              </a>
            </div>
          </div>

          <!-- Facebook Oficial -->
          <div class="step-card contact-channel-card">
            <div class="contact-channel-icon-wrap" style="background: #eff6ff;">
              <Icon name="facebook" size={24} />
            </div>
            <div class="contact-channel-body">
              <h4 class="contact-channel-title">Facebook Oficial</h4>
              <a href={siteConfig.general.facebookUrl} target="_blank" rel="noopener noreferrer" class="contact-channel-link" style="color: #1877f2;">
                {siteConfig.general.messengerName}
              </a>
            </div>
          </div>

          <!-- Ubicación -->
          <div class="step-card contact-channel-card">
            <div class="contact-channel-icon-wrap" style="background: #f8fafc; color: #475569;">
              <Icon name="map-pin" size={24} />
            </div>
            <div class="contact-channel-body">
              <h4 class="contact-channel-title">Ubicación</h4>
              <p class="contact-channel-address">
                {siteConfig.general.address}
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar Column -->
      <Sidebar />
    </div>
  </div>
</Layout>

<style>
  .contact-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .contact-channel-card {
    display: flex;
    gap: 1.15rem;
    align-items: center;
    padding: 1.4rem 1.35rem;
    min-width: 0;
    overflow: hidden;
  }

  .contact-channel-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  .contact-channel-body {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .contact-channel-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: #111827;
  }

  .contact-channel-link {
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    max-width: 100%;
    transition: opacity 0.2s ease;
  }

  .contact-channel-link:hover {
    opacity: 0.85;
    text-decoration: underline;
  }

  .email-text-link {
    font-size: 0.92rem;
    font-weight: 600;
    word-break: break-all;
    overflow-wrap: anywhere;
  }

  .contact-channel-address {
    margin: 0;
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.4;
    word-break: break-word;
  }

  @media (max-width: 600px) {
    .contact-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact';
  document.addEventListener('DOMContentLoaded', () => {
    initContactForm();
  });
</script>
