---
import { getActiveConfig } from '../scripts/content-loader';
import Icon from './Icon.astro';

const siteConfig = getActiveConfig();

const whatsappUrl = `https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me gustaría cotizar un pedido de volantes.')}`;
---

<section class="section section-alt" id="pasos-diseno">
  <div class="container">
    <!-- Los 11 Pasos Originales de Diseño -->
    <div class="section-header">
      <span class="section-tag">Metodología de Imprenta</span>
      <h2 class="section-title">{siteConfig.home.stepsTitle}</h2>
      <p class="section-subtitle">
        Cuidamos cada detalle técnico y visual para que sus volantes generen el máximo impacto y ventas.
      </p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1.25rem; max-width: 920px; margin: 0 auto;">
      {siteConfig.home.steps.map(step => (
        <div class="glass-card" style="padding: 1.5rem 1.75rem; display: flex; gap: 1.25rem; align-items: flex-start;">
          <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--color-primary); color: #ffffff; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.95rem;">
            {step.number}
          </div>
          <div>
            <h3 style="color: #111827; font-size: 1.15rem; font-weight: 700; margin-bottom: 0.35rem;">{step.title}</h3>
            <p style="color: #475569; font-size: 0.975rem; line-height: 1.6; margin: 0;">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA de Cierre Original -->
    <div style="text-align: center; margin-top: 3.5rem; padding: 2.5rem 2rem; background: #ffffff; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm); max-width: 920px; margin-left: auto; margin-right: auto;">
      <h3 style="color: #111827; margin-bottom: 1.25rem; font-size: 1.35rem; font-weight: 800;">
        {siteConfig.home.closingCta}
      </h3>
      <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-whatsapp btn-lg"
      >
        <Icon name="whatsapp" size={22} />
        <span>Contactar por WhatsApp para Hacer su Pedido</span>
      </a>
    </div>
  </div>
</section>
