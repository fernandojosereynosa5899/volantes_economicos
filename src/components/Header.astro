---
import { getActiveConfig } from '../scripts/content-loader';
import Icon from './Icon.astro';

const siteConfig = getActiveConfig();

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Pestañas de navegación con rutas reales (sin /# ni servicios ni precios)
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/productos', label: 'Productos' },
  { href: '/disenos', label: 'Trabajos & Diseños' },
  { href: '/ubicacion', label: 'Ubicación' },
  { href: '/contacto', label: 'Contacto' }
];

const whatsappUrl = `https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me gustaría cotizar con Volantes Económicos.')}`;
---

<!-- Skip to content -->
<a href="#contenido-principal" class="sr-only">Ir al contenido</a>

<!-- Header Principal Estilo Pagina (Idéntico a Captura 154443) -->
<header class="pagina-header" id="main-header">
  <div class="pagina-header-container">
    <!-- Fila Superior: Marca e Información + Botón Hamburguesa -->
    <div class="pagina-header-top">
      <div class="pagina-logo-wrap">
        <a href="/" class="pagina-brand-link">
          <h1 class="pagina-brand-title">VOLANTES ECONÓMICOS</h1>
        </a>
        <p class="pagina-brand-sub">
          <a href="https://maps.app.goo.gl/EnpYZEobB2J1ZGxe9" target="_blank" rel="noopener noreferrer">
            Pte 54 3915, Azcapotzalco CDMX • Lun a Sáb 9:00 - 18:00 hrs
          </a>
        </p>
      </div>

      <!-- Botón de Menú Hamburguesa en Móvil/Tablet -->
      <button class="pagina-menu-toggle" id="paginaMenuToggle" aria-label="Abrir menú de navegación" aria-expanded="false">
        <i class="fas fa-bars" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Buscador en tiempo real integrado tipo píldora -->
    <div class="header-search-wrapper">
      <input 
        type="text" 
        class="header-pill-search" 
        placeholder="Buscar servicios (ej. volantes, tarjetas)..." 
        id="headerSearchInput"
        autocomplete="off"
        aria-label="Buscar servicios de imprenta"
      />
      <button type="button" class="header-pill-search-btn" id="headerSearchBtn" aria-label="Ejecutar búsqueda">
        <i class="fas fa-search" aria-hidden="true"></i>
      </button>

      <!-- Dropdown de resultados rápidos de búsqueda -->
      <div class="header-search-results-dropdown" id="headerSearchResults" style="display: none;">
        <ul id="headerSearchList" class="header-search-list"></ul>
      </div>
    </div>

    <!-- Barra de Navegación (Pestañas limpias y fusionadas) -->
    <nav class="pagina-nav-menu" id="paginaNavMenu" aria-label="Navegación principal">
      <ul class="pagina-nav-list">
        {navItems.map(item => (
          <li>
            <a 
              href={item.href} 
              class:list={['pagina-nav-link', { active: currentPath === item.href }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .pagina-header {
    background: #E3000F;
    color: #ffffff;
    padding: 14px 0 10px;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    border-bottom: 4px solid #FFC107;
    width: 100%;
  }

  .pagina-header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "top search"
      "nav nav";
    gap: 12px 20px;
    align-items: center;
    box-sizing: border-box;
  }

  .pagina-header-top {
    grid-area: top;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }

  .pagina-logo-wrap {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pagina-brand-link {
    text-decoration: none;
    display: inline-block;
  }

  .pagina-brand-title {
    font-size: clamp(1.4rem, 3vw, 1.95rem);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    margin: 0 0 2px 0;
    letter-spacing: 0.5px;
    color: #FFC107;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.35);
    line-height: 1.15;
    text-transform: uppercase;
  }

  .pagina-brand-sub {
    font-size: clamp(0.75rem, 1.6vw, 0.88rem);
    font-weight: 500;
    color: #ffffff;
    margin: 0;
    font-family: 'Montserrat', sans-serif;
  }

  .pagina-brand-sub a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pagina-brand-sub a:hover {
    color: #FFC107;
    text-decoration: underline;
  }

  /* Buscador estilo píldora de Pagina */
  .header-search-wrapper {
    grid-area: search;
    position: relative;
    justify-self: end;
    min-width: 0;
  }

  .header-pill-search {
    padding: 9px 42px 9px 18px;
    border: 2px solid rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-radius: 25px;
    width: 230px;
    font-size: 0.92rem;
    font-family: 'Montserrat', sans-serif;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .header-pill-search::placeholder {
    color: rgba(255, 255, 255, 0.85);
  }

  .header-pill-search:focus {
    outline: none;
    background: #ffffff;
    color: #111827;
    width: 280px;
    border-color: #FFC107;
    box-shadow: 0 0 10px rgba(255, 193, 7, 0.4);
  }

  .header-pill-search-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    font-size: 1rem;
    transition: color 0.2s ease;
    padding: 4px;
  }

  .header-pill-search:focus ~ .header-pill-search-btn {
    color: #E3000F;
  }

  /* Dropdown de búsqueda rápida */
  .header-search-results-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 320px;
    max-height: 380px;
    overflow-y: auto;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    border: 1px solid #e2e8f0;
    z-index: 1001;
    padding: 0.5rem 0;
  }

  .header-search-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.header-search-item a) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    color: #111827;
    text-decoration: none;
    font-size: 0.88rem;
    font-family: 'Montserrat', sans-serif;
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.15s ease;
  }

  :global(.header-search-item a:hover) {
    background: #f8fafc;
    color: #E3000F;
  }

  :global(.header-search-tag) {
    font-size: 0.72rem;
    padding: 2px 8px;
    background: #FFC107;
    color: #111827;
    border-radius: 12px;
    font-weight: 700;
  }

  /* Botón Hamburguesa */
  .pagina-menu-toggle {
    display: none;
    background: #FFC107;
    border: none;
    color: #111827;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1.25rem;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }

  .pagina-menu-toggle:hover {
    background: #ffffff;
    color: #E3000F;
  }

  /* Barra de Navegación */
  .pagina-nav-menu {
    grid-area: nav;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 10px;
    margin-top: 4px;
    width: 100%;
  }

  .pagina-nav-list {
    display: flex;
    list-style: none;
    gap: 8px 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  .pagina-nav-link {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: 'Oswald', sans-serif;
    padding: 6px 14px;
    border-radius: 4px;
    transition: all 0.25s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-block;
  }

  .pagina-nav-link:hover, .pagina-nav-link.active {
    background: #FFC107;
    color: #111827;
    transform: translateY(-1px);
  }

  /* Responsive Mobile Navigation */
  @media screen and (max-width: 900px) {
    .pagina-header {
      padding: 10px 0 8px;
    }

    .pagina-header-container {
      display: flex;
      flex-direction: column;
      padding: 0 16px;
      gap: 10px;
      width: 100%;
      box-sizing: border-box;
    }

    .pagina-header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: 12px;
    }

    .pagina-logo-wrap {
      flex: 1;
      min-width: 0;
    }

    .pagina-brand-title {
      font-size: clamp(1.2rem, 4.8vw, 1.55rem);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.15;
    }

    .pagina-brand-sub {
      font-size: clamp(0.7rem, 2.6vw, 0.8rem);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0.95;
    }

    .pagina-menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      padding: 0;
      background: #FFC107;
      border: 2px solid transparent;
      border-radius: 8px;
      color: #111827;
      font-size: 1.35rem;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      transition: all 0.2s ease;
    }

    .pagina-menu-toggle:hover,
    .pagina-menu-toggle:focus-visible {
      background: #ffffff;
      color: #E3000F;
      outline: none;
    }

    .pagina-menu-toggle:active {
      transform: scale(0.95);
    }

    .header-search-wrapper {
      width: 100%;
      position: relative;
      margin: 0;
    }

    .header-pill-search {
      width: 100% !important;
      max-width: 100%;
      box-sizing: border-box;
      padding: 10px 44px 10px 18px;
      font-size: 0.92rem;
      background: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.55);
      color: #ffffff;
    }

    .header-pill-search::placeholder {
      color: rgba(255, 255, 255, 0.9);
    }

    .header-pill-search:focus {
      width: 100% !important;
      background: #ffffff;
      color: #111827;
      border-color: #FFC107;
      box-shadow: 0 0 12px rgba(255, 193, 7, 0.45);
    }

    .header-pill-search-btn {
      right: 14px;
      font-size: 1.05rem;
    }

    .header-search-results-dropdown {
      width: 100%;
      left: 0;
      right: 0;
      box-sizing: border-box;
      max-height: 300px;
    }

    .pagina-nav-menu {
      display: none;
      width: 100%;
      border-top: 1px solid rgba(255, 255, 255, 0.25);
      padding-top: 10px;
      margin-top: 2px;
    }

    .pagina-nav-menu.active {
      display: block;
      animation: menuSlideDown 0.3s ease forwards;
    }

    .pagina-nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      width: 100%;
      padding: 0;
      margin: 0;
    }

    .pagina-nav-link {
      width: 100%;
      display: block;
      text-align: center;
      padding: 11px 16px;
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.15);
      box-sizing: border-box;
      font-size: 1rem;
      letter-spacing: 0.5px;
    }

    .pagina-nav-link:hover,
    .pagina-nav-link.active {
      background: #FFC107;
      color: #111827;
    }
  }

  @keyframes menuSlideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function initPaginaHeader() {
    const toggleBtn = document.getElementById('paginaMenuToggle');
    const navMenu = document.getElementById('paginaNavMenu');
    const searchInput = document.getElementById('headerSearchInput') as HTMLInputElement | null;
    const searchDropdown = document.getElementById('headerSearchResults');
    const searchList = document.getElementById('headerSearchList');

    // 1. Toggle del menú hamburguesa
    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = navMenu?.classList.toggle('active');
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    // Cierra el menú al hacer clic en un enlace en móviles
    const navLinks = document.querySelectorAll('.pagina-nav-link');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 900) {
          navMenu?.classList.remove('active');
          toggleBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Cierra el menú móvil al hacer clic afuera
    document.addEventListener('click', (e) => {
      if (
        navMenu?.classList.contains('active') && 
        !navMenu.contains(e.target as Node) && 
        !toggleBtn?.contains(e.target as Node)
      ) {
        navMenu.classList.remove('active');
        toggleBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    // 2. Buscador en el header
    const catalog = [
      { name: '1,000 Volantes Económicos', url: '/1000-volantes-precio', tag: 'Paquete' },
      { name: 'Volantes para Pizzas y Restaurantes', url: '/volantes-para-pizzas', tag: 'Comida' },
      { name: 'Volantes 1/4 de Carta (10x14cm)', url: '/precios', tag: 'Medida' },
      { name: 'Volantes 1/2 Carta (14x21cm)', url: '/precios', tag: 'Medida' },
      { name: 'Volantes Carta Completa', url: '/precios', tag: 'Medida' },
      { name: 'Tarjetas de Presentación con Barniz', url: '/disenos', tag: 'Tarjetas' },
      { name: 'Dípticos y Trípticos Corporativos', url: '/disenos', tag: 'Folleto' },
      { name: 'Tabla de Precios y Paquetes', url: '/precios', tag: 'Precios' },
      { name: 'Muestras de Diseños y Trabajos', url: '/disenos', tag: 'Galería' },
      { name: 'Cotizar Proyecto y Contacto', url: '/contacto', tag: 'Cotización' },
      { name: 'Ubicación y Horarios Azcapotzalco', url: '/ubicacion', tag: 'Ubicación' }
    ];

    function renderSearchResults(query: string) {
      if (!searchDropdown || !searchList) return;

      const q = query.trim().toLowerCase();
      if (!q) {
        searchDropdown.style.display = 'none';
        return;
      }

      const matches = catalog.filter(item => 
        item.name.toLowerCase().includes(q) || item.tag.toLowerCase().includes(q)
      );

      if (matches.length === 0) {
        searchList.innerHTML = `
          <li style="padding: 12px 16px; color: #64748b; font-size: 0.85rem; text-align: center;">
            No se encontraron servicios para "<strong>${query}</strong>".<br/>
            <a href="/contacto" style="color: #E3000F; font-weight: 700; text-decoration: underline; margin-top: 4px; display: inline-block;">Cotizar por mensaje</a>
          </li>
        `;
        searchDropdown.style.display = 'block';
        return;
      }

      searchList.innerHTML = matches.map(item => `
        <li class="header-search-item">
          <a href="${item.url}">
            <span>${item.name}</span>
            <span class="header-search-tag">${item.tag}</span>
          </a>
        </li>
      `).join('');

      searchDropdown.style.display = 'block';
    }

    searchInput?.addEventListener('input', (e) => {
      renderSearchResults((e.target as HTMLInputElement).value);
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const q = searchInput.value.trim().toLowerCase();
        if (q) {
          const match = catalog.find(item => item.name.toLowerCase().includes(q) || item.tag.toLowerCase().includes(q));
          if (match) {
            window.location.href = match.url;
          } else {
            window.location.href = '/contacto';
          }
        }
      }
    });

    document.addEventListener('click', (e) => {
      if (searchDropdown && !searchDropdown.contains(e.target as Node) && e.target !== searchInput) {
        searchDropdown.style.display = 'none';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initPaginaHeader);
  document.addEventListener('astro:page-load', initPaginaHeader);
</script>
