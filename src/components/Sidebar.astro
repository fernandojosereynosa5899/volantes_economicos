---
import { getActiveConfig } from '../scripts/content-loader';
import Icon from './Icon.astro';

const siteConfig = getActiveConfig();

const phoneFormatted = siteConfig.general.phoneNumber;
---

<aside class="original-sidebar">
  <!-- Widget de Atención y Ubicación -->
  <div class="sidebar-widget" style="border-top: 3px solid #FFC107; background: #ffffff; padding: 1.25rem;">
    <h4 style="font-family: 'Oswald', sans-serif; font-size: 1.15rem; color: #111827; text-transform: uppercase; margin-bottom: 0.6rem;">
      <i class="fas fa-clock" style="color: #E3000F; margin-right: 6px;"></i> Horario de Atención
    </h4>
    <p style="font-size: 0.9rem; color: #334155; margin-bottom: 0.75rem; line-height: 1.5; font-weight: 600;">
      Lunes a Sábado: 9:00 - 18:00 hrs<br/>
      <span style="font-weight: 500; color: #64748b;">Azcapotzalco, Ciudad de México</span>
    </p>

    <h4 style="font-family: 'Oswald', sans-serif; font-size: 1.05rem; color: #111827; text-transform: uppercase; margin-bottom: 0.4rem; margin-top: 1rem;">
      <i class="fas fa-map-marker-alt" style="color: #E3000F; margin-right: 6px;"></i> Dirección
    </h4>
    <p style="font-size: 0.86rem; color: #475569; margin-bottom: 1rem; line-height: 1.4;">
      Pte 54 3915, Obrero Popular, Azcapotzalco, 02840 Ciudad de México, CDMX
    </p>

    <div style="display: flex; flex-direction: column; gap: 8px;">
      <a 
        href={`https://wa.me/${siteConfig.general.whatsappNumber}?text=${encodeURIComponent('Hola, me interesa cotizar con Volantes Económicos.')}`} 
        target="_blank"
        rel="noopener noreferrer"
        class="btn-hero-whatsapp"
        style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 14px; font-size: 0.9rem; text-decoration: none; border-radius: 6px; font-weight: 700;"
      >
        <i class="fab fa-whatsapp"></i> Cotizar por WhatsApp
      </a>
      <a 
        href="tel:+525540421232" 
        style="display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 700; color: #111827; text-decoration: none; font-size: 0.92rem; padding: 7px; background: #f1f5f9; border-radius: 6px;"
      >
        <i class="fas fa-phone-alt" style="color: #E3000F;"></i> {phoneFormatted}
      </a>
    </div>
  </div>
</aside>
